{
  "id": "pdfme-plugin",
  "name": "PDF (pdfme, plugin)",
  "description": "Génère un PDF à partir d'un template pdfme et des lignes d'une requête. Même rendu que la cellule pdfme native, sans code dans le cœur.",
  "version": "1.0.0",
  "sqljobMinVersion": "0.6.0",
  "types": [
    "pdfme-plugin"
  ],
  "permissions": [
    "ui:render",
    "ui:download"
  ],
  "entry": "plugins/pdfme-plugin/pdfme-plugin.mjs",
  "integrity": "sha256-Nr3GI3n0kGJBOpDzDTyqHRiEq7Eb1fVYDVgAoQWBt90=",
  "cellTypes": [
    {
      "type": "pdfme-plugin",
      "title": "PDF (pdfme, plugin)",
      "icon": "file-text",
      "queries": [
        {
          "key": "data",
          "label": "Requête de données"
        },
        {
          "key": "filename",
          "label": "Nom du fichier PDF"
        }
      ],
      "schema": {
        "template": {
          "label": "Template pdfme (JSON)",
          "inputType": "textarea",
          "rows": 12,
          "required": true,
          "placeholder": "{\"basePdf\": {...}, \"schemas\": [...]}"
        }
      }
    }
  ]
}
