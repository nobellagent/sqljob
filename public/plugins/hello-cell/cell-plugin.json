{
  "id": "hello-cell",
  "name": "Hello Cell",
  "description": "Type de cellule d'exemple : affiche un titre et le nombre de lignes reçues.",
  "version": "1.0.0",
  "sqljobMinVersion": "0.4.0",
  "types": [
    "hello"
  ],
  "permissions": [
    "ui:render"
  ],
  "entry": "hello-cell.mjs",
